# Build artefacts produced by metaphysica-build into local dirs
AutoGenerated/
src/metaphysica/simulations/AutoGenerated

# Website build output (root-level, from metaphysica-build without --out).
# MUST stay anchored with a leading slash: unanchored `js/` etc. also match
# src/metaphysica/website/js/, and maturin's file collector honours
# gitignore — the unanchored form silently stripped every website template
# from the wheel (js/, Pages/, css/ all absent), so installed builds
# regenerated sites from stale copies.
/Pages/
/components/
/css/
/foundations/
/images/
/index.html
/js/
# But DO track the curated assets bundled with the wheel — these ship via
# the maturin include glob in pyproject.toml and end up at
# <site-packages>/metaphysica/website/AutoGenerated/ on install.
!src/metaphysica/website/AutoGenerated/
!src/metaphysica/website/AutoGenerated/**

# Local gnostic / mystical alias overlay — author's personal research
# convenience, intentionally NOT shipped in the published wheel or committed
# to git. See docs/local-overrides.md.
src/metaphysica/_gnostic_aliases.py

# Secrets
*.env
.env*
*_api_key*
secrets_config.py
serviceAccountKey.json

# Local agent / working artefacts (not for publication)
CLAUDE.md
.claude/
wheelhouse/

# Rust backend
target/
Cargo.lock

# Dev-time visual-regression screenshots (large PNGs, local only)
/visual_candidate_smoke/

# ── Website output spilled into the library repo ──────────────────────────────
# `python -m metaphysica.build --out .` run from this directory drops the whole
# generated site here. It belongs in PrincipiaMetaphysica, which is the site
# repo; here it is ~30 MB of regenerable noise that masks real changes.
/css/
/js/
/components/
/foundations/
/images/
/index.html
/visual_baseline/
